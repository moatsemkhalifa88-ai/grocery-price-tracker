# Read-only connection (role web_reader - see sql/migrations/003_web_access.sql).
# Same host as your main DATABASE_URL, but user web_reader and its own password.
DATABASE_URL_READONLY=postgresql://web_reader:<password>@ep-<name>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
NEXT_PUBLIC_GITHUB_URL=https://github.com/moatsemkhalifa88-ai/grocery-price-tracker
